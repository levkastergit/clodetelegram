# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Ваши числовые Telegram ID через запятую (узнать: напишите боту @userinfobot)
# Бот отвечает ТОЛЬКО этим пользователям — все остальные игнорируются
ALLOWED_USER_IDS=123456789,987654321

# Корневая папка с папками проектов, например рабочий стол с git-репозиториями
# (старое имя WORKING_DIR тоже работает)
PROJECTS_DIR=C:\Users\roblox\Desktop

# Необязательно: папка обычного чата (по умолчанию ./workspace/_chat)
# CHAT_DIR=C:\path\to\chat

# Аккаунт GitHub, чьи репозитории показываются как проекты
GITHUB_USER=levkastergit

# Необязательно: дополнительные проекты по абсолютным путям, через точку с запятой
# EXTRA_PROJECTS=C:\path\one;D:\path\two

# Необязательно: гостевой доступ — второй аккаунт с ограничениями.
# Гость видит только проект GUEST_PROJECT и только диалоги, начатые им самим;
# Bash и файлы вне папки проекта ему запрещены, лимиты и личные данные скрыты.
# Username (без @) через запятую и/или числовые ID (надёжнее — ID):
# GUEST_USERNAMES=SomeUser
# GUEST_USER_IDS=123456789
# GUEST_PROJECT=playerok
# GUEST_PROJECT_DIR=C:\playerok

# Мини-приложение Telegram: внешний HTTPS-адрес, по которому доступен
# локальный сервер (порт PORT, по умолчанию 3000). Без него приложение
# не открыть из Telegram. Проще всего поднять туннель:
#   cloudflared tunnel --url http://localhost:3000
# и вписать выданный https-адрес:
# WEBAPP_URL=https://example.trycloudflare.com
# PORT=3000

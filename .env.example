# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Ваши числовые Telegram ID через запятую (узнать: напишите боту @userinfobot)
# Бот отвечает ТОЛЬКО этим пользователям — все остальные игнорируются
ALLOWED_USER_IDS=123456789,987654321

# Корневая папка с папками проектов, например рабочий стол с git-репозиториями
# (старое имя WORKING_DIR тоже работает)
PROJECTS_DIR=C:\Users\roblox\Desktop

# Необязательно: папка обычного чата (по умолчанию ./workspace/_chat)
# CHAT_DIR=C:\path\to\chat

# Аккаунт GitHub, чьи репозитории показываются как проекты
GITHUB_USER=levkastergit

# Необязательно: дополнительные проекты по абсолютным путям, через точку с запятой
# EXTRA_PROJECTS=C:\path\one;D:\path\two
